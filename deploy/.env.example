# Dominio público; Caddy obtiene el certificado HTTPS. El DNS debe apuntar a este servidor.
DOMAIN=erp.miempresa.com
# Contraseña larga y aleatoria: openssl rand -base64 32
DB_PASSWORD=
# Token para dar de alta la primera empresa en /; después ya no se usa: openssl rand -base64 24
SETUP_TOKEN=
# Opcional: habilita Apolo IA.
ANTHROPIC_API_KEY=
BACKUP_KEEP_DAYS=30
